# Copy to .env for local development. Production secrets stay outside Git/image.
TELEGRAM_API_TOKEN=
# Percent-encode reserved characters in database credentials.
DATABASE_URL=postgresql+psycopg://vip_champ:CHANGE_ME@192.168.20.2:5432/vip_champ
MASTERADMIN_LOGIN=
MASTERADMIN_PASSWORD=
# Initial bootstrap requires credentials and exactly one positive Telegram user ID.
MASTERADMIN_TELEGRAM_IDS=
# Optional comma-separated channel/group IDs or @channel usernames.
POST_CHAT_IDS=
BACKUP_DIR=./db/backups
HEARTBEAT_PATH=./db/heartbeat.json
HEALTH_MAX_AGE_SECONDS=90
AUTH_TTL_SECONDS=3600
STATE_TTL_SECONDS=300
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=300
AUTH_GLOBAL_MAX_ATTEMPTS=50
BROADCAST_INTERVAL_SECONDS=0.05
